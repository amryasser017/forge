@startuml
!include style.iuml
left to right direction
skinparam nodesep 14
skinparam ranksep 110
skinparam linetype polyline
title Forge: Use Case Diagram (overview, 21 use cases)
actor "Athlete" as A
actor "Firebase Auth\n(Email, Google)" as FA <<system>>
actor "Cloud Firestore" as FS <<system>>
actor "Image CDN" as CDN <<system>>
actor "YouTube" as YT <<system>>
rectangle "Forge" {
  rectangle "Identity & Profile" {
    usecase "UC-01\nRegister account" as UC01
    usecase "UC-02\nSign in" as UC02
    usecase "UC-03\nSign out" as UC03
    usecase "UC-04\nEdit profile\nand settings" as UC04
  }
  rectangle "Exercise Library" {
    usecase "UC-05\nBrowse and search\nexercises" as UC05
    usecase "UC-06\nView details\nand how-to" as UC06
    usecase "UC-07\nManage favorites" as UC07
    usecase "UC-08\nManage custom\nexercises" as UC08
    usecase "UC-09\nManage exercise\nfolders" as UC09
  }
  rectangle "Weekly Plan" {
    usecase "UC-10\nBuild the\nweekly plan" as UC10
    usecase "UC-11\nEdit the week\n(shift, move, swap,\ncopy, clear, undo)" as UC11
    usecase "UC-12\nApply a\nstarter plan" as UC12
    usecase "UC-21\nAdd exercise to\ntoday's plan" as UC21
  }
  rectangle "Training" {
    usecase "UC-13\nLog a set" as UC13
    usecase "UC-14\nReview exercise\nprogress" as UC14
  }
  rectangle "Home & Attendance" {
    usecase "UC-15\nView Home\ndashboard" as UC15
    usecase "UC-16\nCheck in or undo\na gym day" as UC16
  }
  rectangle "Body & Reports" {
    usecase "UC-17\nSet weight goal and\nlog weigh-ins" as UC17
    usecase "UC-18\nRecord an\nInBody report" as UC18
    usecase "UC-19\nCompare InBody\nreports" as UC19
    usecase "UC-20\nView charts" as UC20
  }
}
A --> UC01
A --> UC02
A --> UC03
A --> UC04
A --> UC05
A --> UC06
A --> UC07
A --> UC08
A --> UC09
A --> UC10
A --> UC11
A --> UC12
A --> UC21
A --> UC13
A --> UC14
A --> UC15
A --> UC16
A --> UC17
A --> UC18
A --> UC19
A --> UC20
UC01 -- FA
UC02 -- FA
UC03 -- FA
UC06 -- CDN
UC06 -- YT
UC12 .> UC10 : <<extend>>
UC11 .> UC10 : <<extend>>
UC21 .> UC13 : <<extend>>
UC16 .> UC15 : <<extend>>
UC10 ..> UC05 : <<include>>
note bottom of FS
  Every use case except UC-03 reads or
  writes data in Cloud Firestore (not drawn per line).
end note
@enduml
