@startuml
!include style.iuml
left to right direction
skinparam nodesep 14
skinparam ranksep 90
title Use Cases 3 of 4: Training, Progress and Home
actor "Athlete" as A
actor "Cloud Firestore" as FS <<system>>
rectangle "Forge" {
  usecase "UC-13\nLog a set\n<size:10>(LogTab, ExerciseDetail)</size>" as UC13
  usecase "UC-14\nReview exercise progress\n<size:10>(ProgressPanel, ExerciseDetail)</size>" as UC14
  usecase "UC-15\nView Home dashboard\n<size:10>(Dashboard.jsx, TodayCard)</size>" as UC15
  usecase "UC-16\nCheck in or undo a gym day\n<size:10>(Dashboard week row)</size>" as UC16
  usecase "UC-21\nAdd exercise to today's plan\n<size:10>(LogTab)</size>" as UC21
}
A --> UC13
A --> UC14
A --> UC15
A --> UC16
A --> UC21
UC13 -- FS
UC14 -- FS
UC15 -- FS
UC16 -- FS
UC21 .> UC13 : <<extend>>
UC16 .> UC15 : <<extend>>
note right of UC13 : PR detection, sets-done counter,\nrest timer and unsaved-value drafts
@enduml
