@startuml
!include style.iuml
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70
skinparam componentStyle uml2
title Component Diagram 1 of 3: Identity, Data Store and Shared Kernel (provided and required interfaces)

component "Firebase <<external system>>" as FB {
  portout "SDK" as FBp1
  portout "SDK " as FBp2
  component "Firebase Auth" as FAUTH
  component "Cloud Firestore" as FS
}

component "Foundation <<sub system>>" as FND {
  portin "uid (from shell)" as FNDin
  component "C2 Data Store" as C2
  component "C10 Units & Dates\n(Shared Kernel)" as C10
}

component "Features <<sub system>>" as FEAT {
  component "C1 Identity & Profile" as C1
  component "C8 Body Tracking" as C8
}

component "C12 App Shell and\nComposition Views" as C12

FAUTH -0)- C1 : Auth SDK
FS -0)- C2 : Firestore SDK
C2 -0)- C1 : IDataStore
C2 -0)- C8 : IDataStore
C1 -0)- C8 : IProfile
C10 -0)- C8 : IUnits
C1 -0)- C12 : IAuth
C1 -0)- C12 : IProfile
C10 -0)- C12 : IUnits, IDates
C12 ..> FNDin : supplies the signed-in uid

note right of C1
  <b>Provides</b>
  IAuth: user, signUp, signIn,
    signInWithGoogle, signOut
  IProfile: profile, saveProfile,
    ensureProfile
  <b>Requires</b>
  IDataStore, Firebase Auth
end note
note left of C2
  <b>Provides IDataStore</b>
  useCol(name) -> items, loading
  add, put, merge, ensureDoc,
  upd, del
  <b>Requires</b> Firestore SDK, uid
end note
note right of C10
  <b>Provides</b>
  IUnits: show(kg), toKg(v), r1
  IDates: ymd, todayStr, fmtDate,
    shortDate, weekStart, byDate
  <b>Requires</b> nothing
end note
note bottom of C8
  <b>Provides</b> IBodyTracker, IBodyReader
  <b>Requires</b> IDataStore, IProfile, IUnits
end note
@enduml
