@startuml
!include style.iuml
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 60
title Forge: Component Diagram (overview, dependencies)

rectangle "App Shell and Composition Views (C12)" as C12 #FFFFFF {
  component "Routing, Layout, Dashboard,\nExercise detail, Exercise sheet,\nCharts, Settings views" as shell
}
rectangle "Feature components" as FEAT #FFFFFF {
  component "C1\nIdentity & Profile" as C1
  component "C3\nExercise Library" as C3
  component "C4\nWorkout Logging" as C4
  component "C5\nProgress & Analytics" as C5
  component "C6\nWeekly Plan" as C6
  component "C7\nAttendance & Goals" as C7
  component "C8\nBody Tracking" as C8
  component "C9\nInBody Reports" as C9
  component "C13\nCrew & Leaderboard\n(planned)" as C13 #E8E8E8
}
rectangle "Foundation" as FND #FFFFFF {
  component "C2\nData Store" as C2
  component "C10\nUnits & Dates" as C10
  component "C11\nUI Kit" as C11
}
cloud "Firebase" as FB {
  database "Cloud Firestore" as FS
  component "Firebase Auth" as FAUTH
}

shell --> C1
shell --> C3
shell --> C4
shell --> C5
shell --> C6
shell --> C7
shell --> C8
shell --> C9
shell --> C11

C1 ..> C2
C3 ..> C2
C4 ..> C3
C4 ..> C2
C5 ..> C4
C5 ..> C8
C5 ..> C9
C6 ..> C3
C6 ..> C5
C6 ..> C2
C7 ..> C4
C7 ..> C6
C7 ..> C1
C7 ..> C2
C8 ..> C1
C8 ..> C2
C9 ..> C2
C13 ..> C5
C13 ..> C1
C13 ..> C2
C1 ..> FAUTH
C2 ..> FS
note bottom of FND : C10 (Units & Dates) is used by C3, C4, C5, C7, C8 and C9\n(not drawn per line). C11 (UI Kit) is used only by the shell and views.
@enduml
