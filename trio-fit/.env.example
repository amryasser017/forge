# --- Supabase (server only: never prefix with NEXT_PUBLIC_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Crew gate ---
# Simple option: the shared password in plain text (kept server-side only).
GATE_PASSWORD=change-me
# Better option: a scrypt hash. Generate with:  node scripts/hash-password.mjs "your password"
# When GATE_PASSWORD_HASH is set it takes priority and GATE_PASSWORD is ignored.
GATE_PASSWORD_HASH=

# Random string, at least 32 characters (signs session cookies).  e.g.  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-chars

# --- Optional ---
APP_TIMEZONE=Africa/Cairo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Only for proxies / local testing; defaults to https://api.anthropic.com
ANTHROPIC_BASE_URL=
